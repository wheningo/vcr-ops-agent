# 虚拟语聊房运营 Agent 配置
# 复制为 .env 并填入真实值

# Anthropic API Key — 不设置则自动走 fake 模式
ANTHROPIC_API_KEY=sk-ant-xxx

# 模型选择（默认 claude-sonnet-4-20250514）
VCR_OPS_MODEL=claude-sonnet-4-20250514

# 最大输出 token
VCR_OPS_MAX_TOKENS=2048

# 温度
VCR_OPS_TEMPERATURE=0.3

# 强制 fake 模式（即使有 API key 也不调 LLM）
VCR_OPS_FAKE_MODE=false
